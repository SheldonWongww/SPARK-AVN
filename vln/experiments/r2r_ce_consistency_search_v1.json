{
  "schema": "navtta.vln_tta_consistency_search.v1",
  "benchmark": "r2r-ce",
  "description": "R2R-CE cross-split consistency search v2 (continuous VLN-CE). Grids centered on prior val_seen winners (vln/results/final/r2r-ce/selected_winners.json); note the continuous models need much smaller LRs than discrete. ETPNav and BEVBert never overlap (strict model barrier). See VLN_TTA_HPARAM_METHODOLOGY.md.",
  "splits": ["val_seen", "val_unseen"],
  "order_seed": 0,
  "settings": ["etpnav-r2r-ce", "bevbert-r2r-ce"],
  "model_barrier": true,
  "selection": {
    "floor_metric": "SR",
    "floor_epsilon": 0.3,
    "gain_metric": "SR",
    "worst_split_objective": true,
    "tie_breakers": ["mean_gain_SR", "mean_gain_SPL", "lower_param_drift", "fewer_updates"],
    "fallback": "paper_default_if_no_consistent_improvement"
  },
  "concurrency": {
    "etpnav-r2r-ce": {"tent": 3, "fstta": 3, "eam": 3, "feedtta": 3, "atena": 3, "idea": 3},
    "bevbert-r2r-ce": {"tent": 3, "fstta": 3, "eam": 3, "feedtta": 3, "atena": 3, "idea": 3}
  },
  "methods": {
    "tent": {
      "base": {"optimizer": "Adam", "action_selection": "argmax", "update_interval": 1},
      "grid": {"lr": [3e-7, 1.5625e-5],
               "scope": [{"norm_scope": "last_k_ln", "last_k_ln": 4},
                         {"norm_scope": "ln"}]},
      "paper_default": {"lr": 1.5625e-5, "norm_scope": "last_k_ln", "last_k_ln": 4}
    },
    "fstta": {
      "base": {"q": 0.1, "rho": 0.95, "tau": 0.7, "a": 0.9, "b": 1.1,
               "last_k_ln": 4, "norm_scope": "last_k_ln",
               "fast_grad_mode": "concordant", "action_selection": "argmax"},
      "grid": {"lr_fast": [3e-7, 1e-6], "lr_slow": [1e-5, 1e-4],
               "mn": [{"m": 4, "n": 16}, {"m": 3, "n": 4}]},
      "paper_default": {"lr_fast": 3e-7, "lr_slow": 1e-5, "m": 4, "n": 16}
    },
    "eam": {
      "base": {"batch_size": 8, "action_selection": "argmax"},
      "grid": {"lr": [1e-6, 3e-6],
               "cfg": [{"confidence_scale": 0.4, "memory_size": 64, "update_interval": 1},
                       {"confidence_scale": 0.4, "memory_size": 32, "update_interval": 1}]},
      "paper_default": {"lr": 1e-6, "confidence_scale": 0.4, "memory_size": 64, "update_interval": 1}
    },
    "feedtta": {
      "base": {"gamma": 0.99, "sgr_seed": 0, "normalize_gradient": false,
               "optimizer_eps": 1e-5, "scope_profile": "last_crossmodal",
               "p": 0.05, "alpha": -0.2, "action_selection": "sample", "action_seed": 0},
      "grid": {"lr": [1e-8, 2e-6, 5e-6]},
      "paper_default": {"lr": 2e-6, "p": 0.05, "alpha": -0.2, "scope_profile": "last_crossmodal"}
    },
    "atena": {
      "base": {"self_loss_weight": 0.1, "action_selection": "argmax"},
      "grid": {"lr_query": [5e-7, 2e-6],
               "block": [{"query_threshold": 0.3, "mix_lambda": 0.5, "lr_self": 1e-8},
                         {"query_threshold": 0.1, "mix_lambda": 0.25, "lr_self": 4e-8}]},
      "paper_default": {"lr_query": 5e-7, "lr_self": 1e-8, "query_threshold": 0.3, "mix_lambda": 0.5}
    },
    "idea": {
      "base": {"prompt_length": 4, "k_max": 32, "lambda": 0.4, "fisher_beta": 0.1,
               "use_fisher": true, "action_selection": "argmax"},
      "grid": {"lr": [1e-3, 3e-3], "tau": [0.5, 0.7]},
      "search_opt_steps": 10,
      "final_opt_steps": 50,
      "paper_default": {"lr": 3e-3, "tau": 0.7}
    }
  }
}
