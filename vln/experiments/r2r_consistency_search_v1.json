{
  "schema": "navtta.vln_tta_consistency_search.v1",
  "benchmark": "r2r",
  "description": "R2R cross-split consistency search v2. Grids are centered on the prior val_seen winners (vln/results/final/r2r/selected_winners.json) which all beat Source on val_seen, PLUS more-conservative low-LR/narrow-scope points as val_unseen-robustness candidates. Selection uses both splits with a no-regression floor; see vln/experiments/VLN_TTA_HPARAM_METHODOLOGY.md.",
  "splits": ["val_seen", "val_unseen"],
  "order_seed": 0,
  "settings": ["duet-r2r", "hamt-r2r", "goat-r2r"],
  "selection": {
    "floor_metric": "SR",
    "floor_epsilon": 0.3,
    "gain_metric": "SR",
    "worst_split_objective": true,
    "tie_breakers": ["mean_gain_SR", "mean_gain_SPL", "lower_param_drift", "fewer_updates"],
    "fallback": "paper_default_if_no_consistent_improvement"
  },
  "concurrency": {
    "duet-r2r": {"tent": 10, "fstta": 12, "eam": 5, "feedtta": 6, "atena": 5, "idea": 4},
    "hamt-r2r": {"tent": 10, "fstta": 11, "eam": 5, "feedtta": 5, "atena": 5, "idea": 4},
    "goat-r2r": {"tent": 10, "fstta": 12, "eam": 5, "feedtta": 6, "atena": 5, "idea": 4}
  },
  "methods": {
    "tent": {
      "base": {"optimizer": "Adam", "action_selection": "argmax", "update_interval": 1},
      "grid": {"lr": [1e-5, 3e-5],
               "scope": [{"norm_scope": "ln"},
                         {"norm_scope": "last_k_ln", "last_k_ln": 9},
                         {"norm_scope": "last_k_ln", "last_k_ln": 4}]},
      "paper_default": {"lr": 1e-5, "norm_scope": "ln"}
    },
    "fstta": {
      "base": {"q": 0.1, "rho": 0.95, "tau": 0.7, "a": 0.9, "b": 1.1,
               "last_k_ln": 4, "norm_scope": "last_k_ln", "slow_optimizer": "AdamW",
               "fast_grad_mode": "concordant", "action_selection": "argmax"},
      "grid": {"lr_fast": [8e-4, 1.8e-3], "lr_slow": [2e-4, 1e-3],
               "mn": [{"m": 3, "n": 4}, {"m": 8, "n": 4}, {"m": 1, "n": 16}]},
      "paper_default": {"lr_fast": 1.8e-3, "lr_slow": 3e-4, "m": 8, "n": 4}
    },
    "eam": {
      "base": {"batch_size": 8, "action_selection": "argmax"},
      "grid": {"lr": [1e-6, 3e-6, 1e-5],
               "cfg": [{"confidence_scale": 0.5, "memory_size": 64, "update_interval": 8},
                       {"confidence_scale": 0.4, "memory_size": 32, "update_interval": 4}]},
      "paper_default": {"lr": 1e-5, "confidence_scale": 0.5, "memory_size": 64, "update_interval": 8}
    },
    "feedtta": {
      "base": {"gamma": 0.8, "sgr_seed": 0, "normalize_gradient": false,
               "optimizer_eps": 1e-5, "action_selection": "sample", "action_seed": 0},
      "grid": {"lr": [1e-6, 2e-6, 5e-6],
               "block": [{"p": 0.05, "alpha": 0.1, "scope_profile": "last_crossmodal"},
                         {"p": 0.1, "alpha": -0.1, "scope_profile": "action_head"}]},
      "paper_default": {"lr": 5e-6, "p": 0.05, "alpha": 0.1, "scope_profile": "last_crossmodal"}
    },
    "atena": {
      "base": {"self_loss_weight": 0.1, "action_selection": "argmax"},
      "grid": {"lr_query": [3.75e-7, 1e-6, 1.6e-6],
               "block": [{"query_threshold": 0.0, "mix_lambda": 0.5, "lr_self": 2e-7},
                         {"query_threshold": 0.1, "mix_lambda": 0.25, "lr_self": 4e-7}]},
      "paper_default": {"lr_query": 1.6e-6, "lr_self": 2e-7, "query_threshold": 0.0, "mix_lambda": 0.5}
    },
    "idea": {
      "base": {"prompt_length": 4, "k_max": 32, "lambda": 0.4, "fisher_beta": 0.1,
               "use_fisher": true, "action_selection": "argmax"},
      "grid": {"lr": [1e-3, 3e-3], "tau": [0.5, 0.7]},
      "search_opt_steps": 10,
      "final_opt_steps": 50,
      "paper_default": {"lr": 3e-3, "tau": 0.7}
    }
  }
}
