  "protocol": {
    "processes": 1,
    "batch_size": 1,
    "causal_online": true,
    "continual_across_episodes": true,
    "reset_boundary": "fresh_process_per_candidate_and_source_setting",
    "action_selection": "sample",
    "action_rng": "torch_seed_0_in_each_fresh_process",
    "method_rng": {
      "eam_replay": "python_random_seed_0",
      "feedtta_sgr": "dedicated_torch_generator_seed_0",
      "atena_self_head": "forked_torch_rng_state_restored_before_next_action",
      "idea": "dedicated_cpu_torch_generator_seed_0"
    },
    "augmentation_rng": "none_during_eval",
    "episode_order_seed": 0,
    "model_seed": 0,
    "selection_is_independent_per_source_setting": true,
    "methods": {
      "eam": {
        "supervision": "unsupervised",
        "update_unit": "action_step",
        "trainable_scope": "smt_transformer_plus_action_head"
      },
      "feedtta": {
        "supervision": "feedback_supervised",
        "feedback": "binary_episode_success_after_termination",
        "update_unit": "episode",
        "action_port": "sample_from_policy_and_optimize_executed_action",
        "trainable_scope": "smt_state_encoder_plus_action_head"
      },
      "atena": {
        "reported_label": "ATENA-AVN(sample)",
        "supervision": "feedback_supervised",
        "feedback": "active_binary_episode_success_after_termination_or_self_prediction",
        "update_unit": "episode",
        "action_port": "sample_from_policy_and_use_executed_action_as_pseudo_expert",
        "official_divergence": "Official VLN executes policy argmax; this AVN task-native variant samples and optimizes the action actually executed.",
        "trainable_scope": "replay_reachable_actor_navigation_policy_plus_self_prediction_head"
      },
      "idea": {
        "supervision": "unsupervised",
        "update_unit": "action_step_prompt_only",
        "base_policy_trainable": false,
        "source_statistics": {
          "description": "128_digest_pinned_source_train_trajectories_per_source_setting",
          "action_selection": "sample",
          "single_source": {
            "manifest": "avn/manifests/idea_source/smt_audio_single_source_sample_seed0.json",
            "manifest_sha256": "695c901045ca1c8234c98432cf7c8c0769ab43b7b2445e47ca6af168567345e3",
