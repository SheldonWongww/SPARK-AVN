  "selection": {
    "unit": "method_and_source_setting",
    "eligibility": [
      "runner_exitcode_zero",
      "manifest_valid",
      "exact_2000_episode_stream",
      "finite_metrics",
      "success_not_below_matched_sampled_source"
    ],
    "primary_metric": "spl",
    "tie_breakers": [
      "success",
      "softspl",
      "lower_relative_parameter_drift",
      "lower_job_id"
    ],
    "atena_additional_constraint": "query_rate_between_0.05_and_0.95",
    "no_eligible_candidate": "report_pareto_frontier_and_stop_without_posthoc_grid_expansion"
  },
  "scheduler": {
    "launcher": "avn/scripts/run_smt_audio_val_search.py",
    "gpu_method_mapping": {
      "eam": 0,
      "feedtta": 1,
      "atena": 2,
      "idea": 3
    },
    "default_concurrency": {
      "eam": 4,
      "feedtta": 4,
      "atena": 3,
      "idea": 2
    },
    "hard_caps": {
      "eam": 10,
      "feedtta": 10,
      "atena": 10,
      "idea": 10
    },
    "hard_cap_basis": "User-approved operational ceiling of 10 workers per method lane after observing low GPU-memory use on the 4x24GB school server; peak GPU and host-memory pressure must still be monitored.",
    "barrier": "within_each_method_single_source_must_finish_before_multi_source",
    "cross_method_execution": "four_method_lanes_run_concurrently"
  },
  "freeze": {
    "grid_expansion_after_results": false,
    "state_transfer_between_candidates_or_source_settings": false,
    "allowed_runtime_overrides": [
      "gpu_ids",
      "concurrency_within_hard_caps",
      "resume",
      "batch_id"
    ]
  },
  "outputs": {
    "result_role": "validation_selected",
    "run_manifest_required": true,
    "episode_metrics_required": true,
    "diagnostics_required": true,
    "raw_logs_are_git_ignored": true
  }
}
