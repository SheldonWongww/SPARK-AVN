  ],
  "purpose": {
    "phase": "development",
    "hypothesis": "Low-dose AVN-specific settings can improve validation SPL without reducing validation SR below the matched sampled-action Source policy.",
    "decision": "Select one SMT+Audio configuration independently for each method and each source setting before any later confirmation run."
  },
  "scope": {
    "task": "avn",
    "benchmark": "mp3d",
    "model": "smt_audio",
    "source_settings_in_order": [
      "single_source",
      "multi_source"
    ],
    "methods": [
      "eam",
      "feedtta",
      "atena",
      "idea"
    ]
  },
  "data": {
    "split": {
      "name": "val",
