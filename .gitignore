# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Python caches and local environments
**/__pycache__/
*.egg-info/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Downloaded, pinned upstream repositories
/references/repos/

# Local AVN datasets (README/manifests remain tracked)
/avn/data/datasets/*
!/avn/data/datasets/.gitkeep
/avn/data/scene_datasets/
/avn/data/scene_observations/
/avn/data/metadata/
/avn/data/sounds/
/avn/data/binaural_rirs/*
!/avn/data/binaural_rirs/.gitkeep

# Future task assets stay local when those task lines are activated.
/vln/data/
/vln/checkpoints/
/vln/results/source/
/vln/results/smoke/
/vln/results/tuning/
/vln/results/audits/
/objectnav/data/
/objectnav/checkpoints/

# MP3D connectivity metadata bundled by continuous VLN upstreams is data.
/vln/baselines/bevbert/precompute_features/connectivity/*
!/vln/baselines/bevbert/precompute_features/connectivity/README.md
/vln/baselines/etpnav/precompute_img_features/connectivity/*
!/vln/baselines/etpnav/precompute_img_features/connectivity/README.md

# Task checkpoints
/avn/checkpoints/source/*
!/avn/checkpoints/source/.gitkeep

# Runtime data accidentally created inside vendored baselines
/avn/baselines/*/data/
/vln/baselines/*/data

# Large/raw experiment artifacts; summaries and manifests stay trackable
**/results/**/raw/
**/results/**/logs/
**/results/**/videos/
**/results/**/tensorboard/
**/results/**/*.pth
**/results/**/*.pt
**/results/**/*.ckpt
**/results/**/events.out.tfevents*

# Curated AVN Markdown analyses stay versioned even though their source logs
# remain local under ignored results/logs directories.
!/avn/results/analysis/
!/avn/results/analysis/**/*.md

# Archives and temporary files
*.zip
*.tar
*.tar.gz
*.tgz
*.tmp
*.bak

# Audio and video assets stay local
*.wav
*.flac
*.mp3
*.ogg
*.mp4
*.mov
*.avi
*.mkv
*.webm
/avn/baselines/smt_audio/res/soundspaces-demo.gif

# Local machine path overrides
.env
.env.*
!.env.example
